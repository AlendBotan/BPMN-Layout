{
  "name": "bpmn-layout-web-vendor",
  "private": true,
  "description": "Rebuilds vendor.js and vendor.css for the BPMN layout page.",
  "scripts": {
    "build": "esbuild vendor-entry.js --bundle --format=iife --minify --target=es2020 --legal-comments=eof --outfile=../vendor.js && esbuild vendor-css.css --bundle --minify --loader:.woff2=dataurl --loader:.woff=dataurl --loader:.ttf=dataurl --loader:.eot=dataurl --loader:.svg=dataurl --outfile=../vendor.css"
  },
  "devDependencies": {
    "bpmn-auto-layout": "2.0.0-alpha.2",
    "bpmn-js": "18.31.0",
    "esbuild": "0.25.0"
  }
}
